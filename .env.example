DATABASE_URL=postgresql://postgres:postgres@localhost:5432/osas_bcp
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=osas_bcp
PGSSL=0
SECRET_KEY=change-this-secret-key-in-production
FLASK_ENV=development

# Deploy / first-login account (admin permissions)
SEED_USERNAME=software.engineer
SEED_PASSWORD=Engineer@OSAS2026
SEED_EMAIL=engineer@bcp.edu.ph
SEED_FULL_NAME=Software Engineer
SEED_ROLE=admin
SEED_CAMPUS_ID=OSAS-ENG-0001

# Session & auth hardening
SESSION_LIFETIME_MINUTES=45
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=5
# Login MFA. Leave OTP_ENABLED=0 on Render unless SMTP is configured.
OTP_ENABLED=1
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RESEND_SECONDS=30
# FLASK_DEBUG=0 and FLASK_ENV=production for deployment
# SESSION_COOKIE_SECURE=1 when serving over HTTPS
SHOW_DEMO_CREDENTIALS=1
ALLOWED_ATTACHMENT_EXTENSIONS=pdf,png,jpg,jpeg,gif,webp,doc,docx,txt,csv,xlsx

OSRM_BASE_URL=http://127.0.0.1:5001
OSRM_PROFILE=foot
OSRM_TIMEOUT_SECONDS=8

CAMPUS_MAP_LAT=14.72632
CAMPUS_MAP_LNG=121.03601
CAMPUS_MAP_ZOOM=18
CAMPUS_NAME=BCP MV Campus
CAMPUS_ADDRESS=Lot 762, Topaz corner Sapphire Street, Millionaires Village, Barangay San Agustin, Novaliches, Quezon City

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=osas@bcp.edu.ph
SMS_PROVIDER_URL=
SMS_API_KEY=

UPLOAD_FOLDER=static/uploads
EXPORT_FOLDER=static/exports
MAX_ATTACHMENT_MB=5
