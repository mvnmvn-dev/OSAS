MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=osas_bcp
SECRET_KEY=change-this-secret-key-in-production
FLASK_ENV=development

# Session & auth hardening
SESSION_LIFETIME_MINUTES=45
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=5

# Self-hosted OSRM (custom campus pathway extract)
# Example: docker run -t -p 5001:5000 osrm/osrm-backend osrm-routed --algorithm mld /data/campus.osrm
OSRM_BASE_URL=http://127.0.0.1:5001
OSRM_PROFILE=foot
OSRM_TIMEOUT_SECONDS=8

# Leaflet campus map center (BCP Quezon City approx)
CAMPUS_MAP_LAT=14.73280
CAMPUS_MAP_LNG=121.05820
CAMPUS_MAP_ZOOM=17

# Optional parent notification delivery
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=osas@bcp.edu.ph
SMS_PROVIDER_URL=
SMS_API_KEY=

UPLOAD_FOLDER=static/uploads
EXPORT_FOLDER=static/exports
MAX_ATTACHMENT_MB=5
