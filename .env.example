MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=osas_bcp
# Or use a single URL instead of the MYSQL_* vars above:
# MYSQL_URL=mysql://user:password@host:3306/osas_bcp
MYSQL_SSL=0
SECRET_KEY=change-this-secret-key-in-production
FLASK_ENV=development

# Session & auth hardening
SESSION_LIFETIME_MINUTES=45
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=5
# FLASK_DEBUG=0 and FLASK_ENV=production for deployment
# SESSION_COOKIE_SECURE=1 when serving over HTTPS
SHOW_DEMO_CREDENTIALS=1
ALLOWED_ATTACHMENT_EXTENSIONS=pdf,png,jpg,jpeg,gif,webp,doc,docx,txt,csv,xlsx

# Self-hosted OSRM (custom campus pathway extract)
# Example: docker run -t -p 5001:5000 osrm/osrm-backend osrm-routed --algorithm mld /data/campus.osrm
OSRM_BASE_URL=http://127.0.0.1:5001
OSRM_PROFILE=foot
OSRM_TIMEOUT_SECONDS=8

# Leaflet campus map — BCP Millionaires Village (MV) Campus
# Lot 762, Topaz cor. Sapphire St., Brgy. San Agustin, Novaliches, Quezon City
CAMPUS_MAP_LAT=14.72632
CAMPUS_MAP_LNG=121.03601
CAMPUS_MAP_ZOOM=18
CAMPUS_NAME=BCP MV Campus
CAMPUS_ADDRESS=Lot 762, Topaz corner Sapphire Street, Millionaires Village, Barangay San Agustin, Novaliches, Quezon City

# Optional parent notification delivery
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=osas@bcp.edu.ph
SMS_PROVIDER_URL=
SMS_API_KEY=

UPLOAD_FOLDER=static/uploads
EXPORT_FOLDER=static/exports
MAX_ATTACHMENT_MB=5
